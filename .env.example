# Variables de la web (panel de negocio y plataforma). Todas son públicas (van al
# bundle del navegador): nunca pongas aquí secretos.
#
# - `npm run dev` usa .env.development (en el repo).
# - Vercel define cada ambiente en Settings → Environment Variables:
#     Production (main → app.vaiinilla.app): valores de production.
#     Preview (develop → dev.vaiinilla.app y PRs): valores de development.
# - Para sobreescribir algo en tu máquina, copia este archivo a .env.local.

# API del backend (obligatoria). development: https://vaiinillaback-development.up.railway.app/api/v1
#                                production:  https://vaiinillaback.up.railway.app/api/v1
VITE_API_URL=

# Cliente web de Firebase del mismo ambiente que el API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo para smoke interno. Debe ser false antes de abrir la Web a usuarios reales.
VITE_ALLOW_UNPUBLISHED_LEGAL_TESTING=false
